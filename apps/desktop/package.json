{
  "name": "desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e && eslint .",
    "e2e": "tsx e2e/run.ts",
    "perf": "tsx e2e/run.ts",
    "build:demo": "tsc --noEmit && vite build -c vite.demo.config.ts && node -e \"require('fs').renameSync('../web/public/demo/app/demo.html','../web/public/demo/app/index.html')\"",
    "dev:demo": "vite -c vite.demo.config.ts --host 127.0.0.1 --port 1421 --strictPort"
  },
  "dependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "@tandem/protocol": "workspace:*",
    "@tandem/ui": "workspace:*",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@xterm/addon-fit": "^0.10",
    "@xterm/addon-search": "^0.15",
    "@xterm/addon-serialize": "^0.13",
    "@xterm/addon-unicode11": "^0.8",
    "@xterm/addon-web-links": "^0.11",
    "@xterm/addon-webgl": "^0.18",
    "@xterm/xterm": "^5",
    "intl-messageformat": "^10.7.16",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.6.2",
    "@testing-library/react": "^16.3.0",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^9",
    "@wdio/globals": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@xterm/headless": "5.5.0",
    "axe-core": "^4.10.3",
    "fast-check": "^4",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "webdriverio": "^9"
