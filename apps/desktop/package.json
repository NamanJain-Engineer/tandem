    "@tauri-apps/cli": "^2.6.2",
    "@testing-library/react": "^16.3.0",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^9",
    "@wdio/globals": "^9",
