{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: every app command.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "allow-app-ready",
    "allow-app-log",
    "allow-app-copy-diagnostics",
    "allow-app-open-logs-folder",
    "allow-app-open-external",
    "allow-app-quit",
    "allow-commands-registry",
    "allow-redact-text",
    "allow-deeplink-pending",
    "allow-window-toggle-maximize",
    "allow-window-minimize",
    "allow-window-close",
    "allow-settings-get-all",
    "allow-settings-set",
    "allow-settings-reset",
    "allow-auth-sign-in",
    "allow-auth-cancel",
    "allow-auth-sign-out",
    "allow-auth-state",
    "allow-auth-continue-offline",
    "allow-entitlement-get",
    "allow-entitlement-refresh",
    "allow-billing-open",
    "allow-telemetry-capture",
    "allow-workspace-pick-folder",
    "allow-workspace-add",
    "allow-workspace-list",
    "allow-workspace-rename",
    "allow-workspace-remove",
    "allow-tab-create",
    "allow-tab-rename",
    "allow-tab-close",
    "allow-tab-reorder",
    "allow-pane-create",
    "allow-pane-list",
    "allow-pane-close",
    "allow-pty-spawn",
    "allow-pty-attach",
    "allow-pty-write",
    "allow-pty-ack",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-term-set-theme-colors"
  ]
}
