{
  "identifier": "test-harness",
  "description": "E2E test harness (debug builds with TANDEM_E2E=1 only; added at runtime).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-test-counters",
    "allow-test-browser-eval",
    "allow-test-spawn-log",
    "allow-test-clock-advance",
    "allow-test-fixture-agent",
    "allow-test-notifier-calls",
    "allow-test-notifier-click",
    "allow-test-set-window-focused",
    "allow-test-thread-seed",
    "allow-test-thread-state",
    "allow-test-thread-seed-events",
    "allow-test-update-installed",
    "allow-test-min-version-shift",
    "allow-test-auth-refresh",
    "allow-test-account-create",
    "allow-test-plugin-connect",
    "allow-test-gateway-metrics",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "allow-test-dictate-key",
    "allow-test-dictate-mic",
    "allow-test-dictate-platform",
    "allow-test-dictate-widget"
  ]
}
