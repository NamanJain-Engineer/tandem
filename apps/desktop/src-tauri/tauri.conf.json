{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibezeo",
  "version": "0.10.0",
  "identifier": "com.vibezeo.tandem",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vibezeo",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#09090b",
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* http://api.tandem.local:8787 https://api.vibezeo.com wss://api.vibezeo.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A desktop workspace for coding agents",
    "publisher": "Vibezeo",
    "homepage": "https://vibezeo.com",
    "resources": {
      "resources/tandem-host/": "host-binaries/",
      "../../../crates/tandem-voice/models/wake/": "models/wake/",
      "resources/remote-web/": "remote-web/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tandem"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
