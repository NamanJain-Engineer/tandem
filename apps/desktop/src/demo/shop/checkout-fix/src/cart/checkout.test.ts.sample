import { describe, expect, it } from "vitest";
import { checkout } from "./checkout";
import { cartFor, guest, signedIn, signedInAgo } from "../../tests/fixtures";

describe("checkout", () => {
  it("charges a signed-in customer the cart's total", async () => {
    const res = await checkout(cartFor(2), signedIn("ana"));
    expect(res.status).toBe(200);
  });

  it("applies the session's coupon", async () => {
    const res = await checkout(cartFor(2), signedIn("ana", "SPRING10"));
    expect(await res.json()).toMatchObject({ charged: 1800 });
  });

  it("applies a coupon however it was typed", async () => {
    const res = await checkout(cartFor(2), signedIn("ana", " spring10"));
    expect(await res.json()).toMatchObject({ charged: 1800 });
  });

  it("sends a guest to sign in first, and back to checkout after", async () => {
    const res = await checkout(cartFor(1), guest("/checkout"));
    expect(res.status).toBe(302);
    expect(res.headers.get("location")).toBe("/login?next=%2Fcheckout");
  });

  it("renews a session that expired a moment ago", async () => {
    const res = await checkout(cartFor(1), signedInAgo("ana", 60_000));
    expect(res.status).toBe(200);
  });

  it("never sends someone who just signed in back to /login", async () => {
    const res = await checkout(cartFor(1), signedInAgo("ana", 5 * 60_000));
    expect(res.headers.get("location") ?? "").not.toMatch(/^\/login/);
  });

  it("keeps the coupon when it renews the session", async () => {
    const res = await checkout(cartFor(2), signedInAgo("ana", 60_000, "SPRING10"));
    expect(await res.json()).toMatchObject({ charged: 1800 });
  });

  it("keeps the cart when a guest is sent to sign in", async () => {
    const cart = cartFor(3);
    await checkout(cart, guest());
    expect(cart.items).toHaveLength(3);
  });
});
