import { subtotal, type Cart } from "./cart";
import { stack, type StackRule } from "./rules";

export type Coupon = {
  code: string;
  percent: number;
  /** The total (in cents) the cart must reach when the coupon's turn comes. */
  minimum: number;
  /** Lower goes first when coupons stack. */
  priority: number;
  /** Takes no other coupon with it. */
  alone?: boolean;
};

const COUPONS: Record<string, Coupon> = {
  STAFF30: { code: "STAFF30", percent: 30, minimum: 0, priority: 0, alone: true },
  BULK15: { code: "BULK15", percent: 15, minimum: 10_000, priority: 1 },
  SPRING10: { code: "SPRING10", percent: 10, minimum: 0, priority: 2 },
  WELCOME5: { code: "WELCOME5", percent: 5, minimum: 0, priority: 3 },
};

/** The coupons that `codes` name: one code, or none, works as before. */
export function couponsFor(codes: string | string[] | null): Coupon[] {
  const list = codes === null ? [] : typeof codes === "string" ? [codes] : codes;
  return list.flatMap((code) => COUPONS[code] ?? []);
}

/** The cart's total in cents after its coupons, taken in priority order
 * (`stack` in rules.ts): each one comes off what the ones before it left.
 * A coupon whose minimum the cart no longer reaches takes nothing off. */
export function applyCoupon(cart: Cart, codes: string | string[] | null, rules: StackRule[] = []): number {
  let total = subtotal(cart);
  for (const coupon of stack(couponsFor(codes), rules)) {
    if (total >= coupon.minimum) total -= Math.round((total * coupon.percent) / 100);
  }
  return total;
}
