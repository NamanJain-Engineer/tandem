import { useState, type KeyboardEvent } from "react";
import type { Product } from "../catalog/product";

type Props = { results: Product[]; onOpen: (product: Product) => void };

/** Search results: one row per product, each opening its page. Arrow keys,
 * Home and End move the highlight and Enter opens it, without a mouse. */
export function Results({ results, onOpen }: Props) {
  const [active, setActive] = useState(0);
  if (results.length === 0) return <p className="empty">No products match.</p>;
  const move = (to: number) => setActive(Math.max(0, Math.min(results.length - 1, to)));
  const onKeyDown = (e: KeyboardEvent<HTMLUListElement>) => {
    if (e.key === "ArrowDown") move(active + 1);
    else if (e.key === "ArrowUp") move(active - 1);
    else if (e.key === "Home") move(0);
    else if (e.key === "End") move(results.length - 1);
    else if (e.key === "Enter" && results[active]) onOpen(results[active]);
    else return;
    e.preventDefault();
  };
  return (
    <ul className="results" role="listbox" tabIndex={0} onKeyDown={onKeyDown}>
      {results.map((product) => (
        <li
          key={product.id}
          role="option"
          aria-selected={product.id === results[active]?.id}
          onClick={() => onOpen(product)}
        >
          {product.name}
        </li>
      ))}
    </ul>
  );
}
