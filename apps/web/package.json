{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:site": "pnpm --filter desktop build:demo && SITE_EXPORT=1 next build && node scripts/strip-runtime.mjs && node scripts/check-routes.mjs",
    "start": "next start --port 3000",
    "test": "vitest run",
    "lint": "fumadocs-mdx && tsc --noEmit && eslint .",
    "test:e2e": "playwright test",
    "test:site": "playwright test -c playwright.site.config.ts",
    "lhci": "lhci autorun",
    "new-post": "node scripts/new-post.mjs",
    "postinstall": "fumadocs-mdx",
    "build:remote-lan": "vite build --config remote-lan/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tandem/protocol": "workspace:*",
    "@tandem/remote": "workspace:*",
    "@tandem/ui": "workspace:*",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "12.0.3",
    "fumadocs-ui": "15.8.5",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.3",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "ws": "^8.18.0"
  }
}
