  {
    "id": "claude",
    "label": "Claude Code",
    "vendor": "Anthropic",
    "logo": "C",
    "commands": [
      "claude"
    ],
    "versionCmd": [
      "--version"
    ],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "install": {
      "mac": "curl -fsSL https://claude.ai/install.sh | bash",
      "lin": "curl -fsSL https://claude.ai/install.sh | bash",
      "win": "irm https://claude.ai/install.ps1 | iex"
    },
    "loginCmd": [
      "/login"
    ],
    "loginMode": "tui_slash",
    "logoutCmd": [
      "/logout"
    ],
    "statusCmd": null,
    "chatAdapter": "claude",
    "acpCmd": null,
    "adapterVersions": ">=1.0.0",
    "providerHomeEnv": "CLAUDE_CONFIG_DIR",
    "homeStrategy": "env",
    "keychainIsolation": "unsupported_mac",
    "resumeCmdTemplate": [
      "--resume",
      "{session_id}"
    ],
    "supportsResume": true,
    "newlineSequence": "\u001b\r",
    "hooksSupport": "claude-hooks",
    "usageLogGlobs": [
      "projects/**/*.jsonl"
    ],
    "skillsDir": "skills",
    "cheapModel": "haiku",
    "titlePatterns": [
      "^[✳✶✻✽✢·*]\\s*(.+)$"
    ],
    "readyPatterns": [
      "^>\\s",
      "\\? for shortcuts"
    ],
    "waitingPatterns": [
      "Do you want to proceed\\?",
      "❯ 1\\. Yes"
    ],
    "limitPatterns": [
      "usage limit reached",
      "rate limit",
      "\\b429\\b"
    ],
    "onboardingSeed": {
      "file": ".claude.json",
      "merge": {
        "hasCompletedOnboarding": true,
        "theme": "{theme}"
      }
    },
    "mcpNative": {
      "kind": "claude_json",
      "file": ".claude.json",
      "key": "mcpServers"
    }
  },
